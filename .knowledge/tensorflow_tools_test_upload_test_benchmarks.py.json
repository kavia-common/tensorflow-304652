{"is_source_file": true, "format": "Python", "description": "This file is a Python script used for uploading benchmark test results to a Google Cloud Datastore. It scans a specified directory for benchmark result files, parses JSON-encoded data from these files, and uploads the corresponding data entities (Test and Entry) to the datastore. It includes functions for file locking to allow concurrent execution, and moves processed files to an archive directory.", "external_files": ["google.cloud.datastore", "os", "shutil", "json", "argparse", "datetime", "fcntl"], "external_methods": ["datastore.Client", "datastore.Entity", "client.put_multi"], "published": ["main", "upload_benchmark_files", "upload_benchmark_data", "trylock", "unlock", "lock", "list_files_by_mtime", "is_real_file", "get_mtime"], "classes": [], "methods": [{"name": "main()", "description": "Main entry point to parse command-line arguments and initiate the upload process.", "scope": "", "scopeKind": ""}, {"name": "upload_benchmark_files(opts)", "description": "Finds benchmark files in the data directory, processes and uploads their data, then moves files to archive.", "scope": "", "scopeKind": ""}, {"name": "upload_benchmark_data(client, data)", "description": "Parses JSON benchmark data from a file and uploads it as entities to the datastore.", "scope": "", "scopeKind": ""}, {"name": "trylock(fd)", "description": "Attempts to acquire an exclusive non-blocking lock on a file descriptor.", "scope": "", "scopeKind": ""}, {"name": "unlock(fd)", "description": "Releases a lock on a file descriptor.", "scope": "", "scopeKind": ""}, {"name": "lock(fd)", "description": "Acquires an exclusive lock on a file descriptor.", "scope": "", "scopeKind": ""}, {"name": "list_files_by_mtime(dirpath)", "description": "Returns a list of filenames sorted by their modification time.", "scope": "", "scopeKind": ""}, {"name": "is_real_file(dirpath, fname)", "description": "Checks if a path is a real file and not a symbolic lin