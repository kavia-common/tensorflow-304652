{"is_source_file": true, "format": "C++", "description": "This file implements parts of the nullary spmd (single program multiple data) expander for TensorFlow DTensor's MLIR passes. It defines methods for expanding operations, computing forward and backward layouts, and manipulating MLIR operations related to nullary tensor operations in a distributed setting.", "external_files": ["tensorflow/dtensor/mlir/expansions/nullary_spmd_expander.h", "llvm/ADT/SmallPtrSet.h", "llvm/ADT/SmallVector.h", "llvm/Support/FormatVariadic.h", "mlir/IR/Attributes.h", "mlir/IR/Builders.h", "mlir/IR/BuiltinTypes.h", "mlir/IR/Operation.h", "mlir/IR/Value.h", "mlir/Support/LLVM.h", "tensorflow/compiler/mlir/tensorflow/ir/tf_device.h", "tensorflow/compiler/mlir/tensorflow/ir/tf_ops.h", "tensorflow/core/platform/errors.h", "tensorflow/dtensor/cc/dstatus.h", "tensorflow/dtensor/cc/tensor_layout.h", "tensorflow/dtensor/mlir/collectives.h", "tensorflow/dtensor/mlir/layout_parsing.h", "tensorflow/dtensor/mlir/shape_utils.h"], "external_methods": ["ExtractLayoutFromOp", "InferSPMDExpandedLocalShape", "EmitAllScatter", "ExtractDeviceMeshFromOp"], "published": ["NullarySPMDExpander::ExpandOp", "NullarySPMDExpander::ComputeLayoutForward", "NullarySPMDExpander::ComputeLayoutBackward"], "classes": [{"name": "NullarySPMDExpander", "description": "A class that handles expansion and layout computation for nullary tensor operations in TensorFlow's DTensor MLIR pipeline."}], "methods": [{"name": "StatusOr<mlir::Operation * > ExpandOp(mlir::Operation * op)", "description": "Expands a given MLIR operation by handling cases for constant splats and splitting outputs for distributed execution while assuming full replication if needed.", "scope": "tensorflow::dtensor::NullarySPMDExpander", "scopeKind": "class"}, {"name": "StatusOr<llvm::DenseMap<int,Layout>> ComputeLayoutForward(mlir::Operation * op,const llvm::DenseMap<int,Layout> & input_layouts)", "description": "Computes the output layout for the operation